# Database Connection (PostgreSQL / Supabase Session Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key_here"

# Environment
NODE_ENV="development"

# App Public URL & API Fetcher Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_USE_MOCK="false"

# Admin Authentication Secret (Server-side only)
ADMIN_SESSION_SECRET="ganti_dengan_random_string_aman_minimal_32_karakter"

# Optional fallback only if Gemini API key has not been configured in Admin DB Settings
GEMINI_API_KEY=""
